---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { aboutContent } from "../config/content.ts";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{aboutContent.meta.title}</title>
    <meta name="description" content={aboutContent.meta.description} />
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "dark";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) {
                document.documentElement.classList.add("dark");
              } else {
                document.documentElement.classList.remove("dark");
              }
            }
          });
      });
    </script>
    <style>
      html,
      body {
        overflow-x: hidden;
      }

      .dot-hexagon-light {
        background-image: radial-gradient(
            circle,
            #80808045 1px,
            transparent 1px
          ),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(
            circle,
            #ffffff35 1px,
            transparent 1px
          ),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }
    </style>
  </head>
  <body
    class="min-h-screen flex flex-col bg-white dark:bg-neutral-900 transition-colors duration-300"
  >
    <div class="relative flex-grow flex flex-col">
      <div class="absolute inset-0 z-0">
        <div
          class="absolute inset-0 -z-10 dot-hexagon-light dark:dot-hexagon-dark"
        >
        </div>
        <div
          class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(255,255,255,0.5)_60%,rgba(255,255,255,0.9)_85%,white_100%)] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(23,23,23,0.5)_60%,rgba(23,23,23,0.9)_85%,rgb(23,23,23)_100%)] -z-10"
        >
        </div>
        <div
          class="absolute left-0 right-0 top-0 -z-10 m-auto h-[1200px] w-[1200px] rounded-full bg-neutral-400 opacity-10 blur-[100px]"
        >
        </div>
      </div>

      <Navigation />
      <section class="relative z-20 w-full max-w-[896px] mx-auto mt-24 mb-12 px-4 sm:px-6 lg:px-0">
        <div class="relative z-20 w-full mx-auto lg:mx-0">
          <h2
            class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-3xl lg:text-4xl"
          >
            {aboutContent.title}
          </h2>
          <div class="flex flex-col md:flex-row gap-8 mt-3 sm:mt-4 lg:mt-6">
            <div class="w-full md:w-1/2 flex flex-col">
              <p
                class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
              >
                {aboutContent.description}
              </p>
              <div class="mt-auto pt-4 flex flex-wrap gap-2">
                {
                  aboutContent.skills.map((skill) => (
                    <span class="px-3 py-1 text-sm bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-200 rounded-full">
                      {skill}
                    </span>
                  ))
                }
              </div>
            </div>
            <div class="w-full md:w-1/2 flex justify-center md:justify-end">
              <div class="relative w-full max-w-[360px] aspect-square">
                <img
                  src={aboutContent.image.src}
                  alt={aboutContent.image.alt}
                  class="object-cover rounded-xl w-full h-full"
                />
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col md:flex-row mt-20">
          <div class="flex-1">
            <h2 class="mb-2 text-2xl font-bold dark:text-neutral-200">
              {aboutContent.experience.title}
            </h2>
            <div class="py-10">
              {
                aboutContent.experience.items.map((item) => (
                  <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
                    <div class="relative flex flex-col justify-start pl-12">
                      <div class="absolute top-0 left-0 z-40 flex items-center justify-center -translate-x-1/2 bg-white border rounded-full w-14 h-14 border-neutral-300 dark:border-neutral-700 overflow-hidden shadow-sm">
                        <img
                          src={item.logo}
                          alt={item.company}
                          class="w-9 h-9 object-contain"
                        />
                      </div>
                      <p class="text-xs uppercase text-neutral-400 dark:text-neutral-500 tracking-widest">
                        {item.period}
                      </p>
                      <h3 class="my-1 text-lg font-bold dark:text-neutral-100">
                        {item.position}
                      </h3>
                      <p class="mb-1 text-sm font-medium dark:text-neutral-300">
                        {item.company}
                      </p>
                      <p class="text-sm font-light text-neutral-600 dark:text-neutral-400">
                        {item.description}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>

            <h2 class="mb-2 mt-12 text-2xl font-bold dark:text-neutral-200">
              {aboutContent.education.title}
            </h2>
            <div class="py-10">
              {
                aboutContent.education.items.map((item) => (
                  <div class="pb-10 border-l border-gray-200 last:border-l-0 dark:border-neutral-700">
                    <div class="relative flex flex-col justify-start pl-12">
                      <div class="absolute top-0 left-0 z-40 flex items-center justify-center -translate-x-1/2 bg-white border rounded-full w-14 h-14 border-neutral-300 dark:border-neutral-700 overflow-hidden shadow-sm">
                        <img
                          src={item.logo}
                          alt={item.institution}
                          class="w-9 h-9 object-contain"
                        />
                      </div>
                      <p class="text-xs uppercase text-neutral-400 dark:text-neutral-500 tracking-widest">
                        {item.period}
                      </p>
                      <h3 class="my-1 text-lg font-bold dark:text-neutral-100">
                        {item.degree}
                      </h3>
                      <p class="text-sm font-medium dark:text-neutral-300">
                        {item.institution}
                      </p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="w-full md:w-[360px] md:ml-8 mt-12 md:mt-0">
            <h2 class="mb-2 text-2xl font-bold dark:text-neutral-200">
              {aboutContent.connect.title}
            </h2>
            <div class="py-[30px]">
              <p
                class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
              >
                {aboutContent.connect.description}
              </p>
            </div>
            
            <h2 class="mb-2 mt-8 text-2xl font-bold dark:text-neutral-200">
              {aboutContent.hobbies.title}
            </h2>
            <div class="py-[30px]">
              <ul class="space-y-4">
                {
                  aboutContent.hobbies.items.map((hobby) => (
                    <li class="flex items-start">
                      <svg class="w-5 h-5 mt-1 mr-3 text-indigo-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                      </svg>
                      <span class="text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:text-base">{hobby}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>

        <div class="mt-20">
          <h2 class="mb-2 text-2xl font-bold dark:text-neutral-200">
            {aboutContent.competencies.title}
          </h2>
          <p
            class="mt-2 text-sm leading-6 text-gray-600 dark:text-neutral-400 sm:leading-7 lg:leading-8 sm:text-base lg:text-lg"
          >
            {aboutContent.competencies.description}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
            {
              aboutContent.competencies.items.map((item) => (
                <div class="flex flex-col p-5 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-white/50 dark:bg-neutral-800/50">
                  <h3 class="text-base font-bold text-neutral-900 dark:text-neutral-100">
                    {item.title}
                  </h3>
                  <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
                    {item.description}
                  </p>
                  {item.link && (
                    <a
                      href={item.link.href}
                      class="mt-3 text-sm font-medium text-neutral-900 dark:text-neutral-100 hover:underline"
                    >
                      {item.link.text}
                    </a>
                  )}
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </div>

    <Footer />
  </body>
</html>
