---
import Navigation from "../../components/Navigation.astro";
import Footer from "../../components/Footer.astro";
import { getProjectBySlug, getAllProjectSlugs } from "../../utils/getProjects";

export async function getStaticPaths() {
  return getAllProjectSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const project = slug ? getProjectBySlug(slug) : null;

if (!project || !project.Content) {
  return Astro.redirect("/Portfolio-CV-Blog/projects/");
}

const { frontmatter, Content } = project;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{frontmatter.title} - Raphael Northoff</title>
    <meta name="description" content={frontmatter.description} />
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "light";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) {
                document.documentElement.classList.add("dark");
              } else {
                document.documentElement.classList.remove("dark");
              }
            }
          });
      });
    </script>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
      }
      .prose img {
        margin-top: 1.75rem;
        margin-bottom: 0.5rem;
      }

      .dot-hexagon-light {
        background-image: radial-gradient(
            circle,
            #80808045 1px,
            transparent 1px
          ),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(
            circle,
            #ffffff35 1px,
            transparent 1px
          ),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }
    </style>
  </head>
  <body class="bg-white dark:bg-neutral-900 transition-colors duration-300">
    <div class="fixed inset-0 z-0 pointer-events-none">
      <div
        class="absolute inset-0 -z-10 dot-hexagon-light dark:dot-hexagon-dark"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(255,255,255,0.5)_60%,rgba(255,255,255,0.9)_85%,white_100%)] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(23,23,23,0.5)_60%,rgba(23,23,23,0.9)_85%,rgb(23,23,23)_100%)] -z-10"
      >
      </div>
      <div
        class="absolute left-0 right-0 top-0 -z-10 m-auto h-[1200px] w-[1200px] rounded-full bg-neutral-400 opacity-10 blur-[100px]"
      >
      </div>
    </div>

    <main class="flex-1 relative z-10">
      <Navigation />

      <article
        class="relative z-20 w-full max-w-[896px] mx-auto mt-24 mb-12 px-4 sm:px-6 lg:px-0"
      >
        <a
          href="/Portfolio-CV-Blog/projects/"
          class="inline-flex items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors mb-6"
        >
          ← Back to projects
        </a>

        <header>
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <h1
              class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-3xl lg:text-4xl"
            >
              {frontmatter.title}
            </h1>
            {
              frontmatter.status && (
                <span class="shrink-0 mt-1 text-xs font-semibold px-2.5 py-1 rounded-full bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-200">
                  {frontmatter.status}
                </span>
              )
            }
          </div>

          {
            frontmatter.period && (
              <p class="mt-2 text-xs uppercase tracking-widest text-neutral-400 dark:text-neutral-500">
                {frontmatter.period}
              </p>
            )
          }

          {
            frontmatter.description && (
              <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
                {frontmatter.description}
              </p>
            )
          }

          {
            frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-2">
                {frontmatter.tags.map((tag) => (
                  <span class="px-3 py-1 text-xs bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-200 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            )
          }
        </header>

        <hr class="my-8 border-neutral-200 dark:border-neutral-700" />

        <div class="prose prose-neutral dark:prose-invert max-w-none">
          <Content />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>
