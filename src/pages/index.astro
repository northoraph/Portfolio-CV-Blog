---
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { siteConfig, homeContent, supabaseConfig } from "../config/content.ts";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteConfig.title}</title>
    <meta name="description" content={siteConfig.description} />
    <script is:inline>
      (function () {
        const savedTheme = localStorage.getItem("theme") || "light";
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const initialTheme =
          savedTheme === "system"
            ? prefersDark
              ? "dark"
              : "light"
            : savedTheme;

        if (initialTheme === "dark") {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <script>
      document.addEventListener("DOMContentLoaded", function () {
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            if (localStorage.getItem("theme") === "system") {
              if (e.matches) {
                document.documentElement.classList.add("dark");
              } else {
                document.documentElement.classList.remove("dark");
              }
            }
          });
      });
    </script>
    <script
      define:vars={{
        SUPABASE_URL: supabaseConfig.url,
        SUPABASE_ANON_KEY: supabaseConfig.anonKey,
      }}
      type="module"
    >
      const form = document.getElementById("comment-form");
      const nameInput = document.getElementById("comment-name");
      const messageInput = document.getElementById("comment-message");
      const honeypot = document.getElementById("comment-hp");
      const statusEl = document.getElementById("comment-status");
      const listEl = document.getElementById("comments-list");
      const emptyEl = document.getElementById("comments-empty");
      const unconfiguredEl = document.getElementById("comments-unconfigured");
      const submitBtn = form.querySelector('button[type="submit"]');

      if (!SUPABASE_URL || !SUPABASE_ANON_KEY) {
        unconfiguredEl.classList.remove("hidden");
        submitBtn.disabled = true;
      } else {
        const { createClient } = await import(
          "https://esm.sh/@supabase/supabase-js@2"
        );
        const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        const ADJECTIVES = [
          "Swift", "Clever", "Curious", "Bold", "Bright", "Calm",
          "Eager", "Gentle", "Happy", "Quiet", "Sunny", "Witty",
        ];
        const ANIMALS = [
          "Falcon", "Otter", "Fox", "Panda", "Wolf", "Hawk",
          "Lynx", "Owl", "Tiger", "Dolphin", "Koala", "Heron",
        ];

        function randomName() {
          const adj = ADJECTIVES[Math.floor(Math.random() * ADJECTIVES.length)];
          const animal = ANIMALS[Math.floor(Math.random() * ANIMALS.length)];
          const num = Math.floor(Math.random() * 90 + 10);
          return `${adj} ${animal} ${num}`;
        }

        function timeAgo(dateStr) {
          const diffMs = Date.now() - new Date(dateStr).getTime();
          const mins = Math.floor(diffMs / 60000);
          if (mins < 1) return "just now";
          if (mins < 60) return `${mins}m ago`;
          const hours = Math.floor(mins / 60);
          if (hours < 24) return `${hours}h ago`;
          const days = Math.floor(hours / 24);
          if (days < 30) return `${days}d ago`;
          return new Date(dateStr).toLocaleDateString();
        }

        function renderComments(comments) {
          listEl.querySelectorAll(".comment-item").forEach((el) => el.remove());

          if (!comments.length) {
            emptyEl.classList.remove("hidden");
            return;
          }
          emptyEl.classList.add("hidden");

          for (const c of comments) {
            const item = document.createElement("div");
            item.className =
              "comment-item p-4 rounded-xl border border-neutral-200 dark:border-neutral-700 bg-white/50 dark:bg-neutral-800/50";

            const header = document.createElement("div");
            header.className = "flex items-center justify-between mb-1 gap-3";

            const name = document.createElement("span");
            name.className =
              "text-sm font-semibold text-neutral-900 dark:text-neutral-100";
            name.textContent = c.name;

            const time = document.createElement("span");
            time.className =
              "text-xs text-neutral-400 dark:text-neutral-500 shrink-0";
            time.textContent = timeAgo(c.created_at);

            header.appendChild(name);
            header.appendChild(time);

            const msg = document.createElement("p");
            msg.className =
              "text-sm text-neutral-600 dark:text-neutral-400 whitespace-pre-wrap break-words";
            msg.textContent = c.message;

            item.appendChild(header);
            item.appendChild(msg);
            listEl.appendChild(item);
          }
        }

        async function loadComments() {
          const { data, error } = await supabase
            .from("comments")
            .select("name, message, created_at")
            .order("created_at", { ascending: false })
            .limit(100);

          if (error) {
            console.error(error);
            return;
          }
          renderComments(data);
        }

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          statusEl.classList.add("hidden");

          if (honeypot.value) return;

          const message = messageInput.value.trim();
          if (!message) return;

          const RATE_LIMIT_MS = 15000;
          const last = Number(localStorage.getItem("lastCommentAt") || 0);
          if (Date.now() - last < RATE_LIMIT_MS) {
            statusEl.textContent =
              "Please wait a few seconds before posting again.";
            statusEl.classList.remove("hidden");
            return;
          }

          let name = nameInput.value.trim();
          if (!name) name = randomName();

          submitBtn.disabled = true;

          const { error } = await supabase
            .from("comments")
            .insert({ name, message });

          submitBtn.disabled = false;

          if (error) {
            statusEl.textContent = "Something went wrong, please try again.";
            statusEl.classList.remove("hidden");
            console.error(error);
            return;
          }

          localStorage.setItem("lastCommentAt", String(Date.now()));
          nameInput.value = "";
          messageInput.value = "";
          loadComments();
        });

        loadComments();
      }
    </script>
    <style>
      html,
      body {
        overflow-x: hidden;
      }

      body {
        margin: 0;
        font-family:
          system-ui,
          -apple-system,
          sans-serif;
      }

      @keyframes float {
        0% {
          transform: scale(1.2);
        }
        50% {
          transform: scale(1.3);
        }
        100% {
          transform: scale(1.2);
        }
      }

      .dot-hexagon-light {
        background-image: radial-gradient(
            circle,
            #80808045 1px,
            transparent 1px
          ),
          radial-gradient(circle, #80808045 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }

      .dot-hexagon-dark {
        background-image: radial-gradient(
            circle,
            #ffffff35 1px,
            transparent 1px
          ),
          radial-gradient(circle, #ffffff35 1px, transparent 1px);
        background-size: 24px 41.57px;
        background-position:
          0 0,
          12px 20.78px;
      }
    </style>
  </head>
  <body
    class="min-h-screen flex flex-col bg-white dark:bg-neutral-900 transition-colors duration-300"
  >
    <div class="relative flex-grow flex flex-col">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute inset-0 dot-hexagon-light dark:dot-hexagon-dark">
        </div>
        <div
          class="absolute inset-0 bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(255,255,255,0.5)_60%,rgba(255,255,255,0.9)_85%,white_100%)] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_50%,transparent_0%,rgba(23,23,23,0.5)_60%,rgba(23,23,23,0.9)_85%,rgb(23,23,23)_100%)]"
        >
        </div>
        <div
          class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 h-[1200px] w-[1200px] rounded-full bg-neutral-400 opacity-10 blur-[100px] dark:bg-neutral-600 dark:opacity-15"
          style="max-height: 100vh; max-width: 100vw;"
        >
        </div>
      </div>

      <Navigation />
      <div class="relative flex flex-col flex-1 pt-4">
        <main class="flex-grow flex flex-col">
          <div class="flex items-center justify-center py-12 md:py-20">
            <div
              class="flex flex-col lg:flex-row items-center justify-between w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 gap-8 lg:gap-12"
            >
              <div class="w-full lg:w-[45%] text-center lg:text-left">
                <h1
                  class="text-3xl font-bold tracking-tight text-neutral-900 dark:text-neutral-100 sm:text-4xl"
                >
                  {homeContent.title}
                </h1>
                <p
                  class="mt-3 text-lg leading-7 text-neutral-600 dark:text-neutral-400"
                >
                  {homeContent.description}
                </p>
                <div class="flex flex-row flex-wrap gap-4 mt-4 justify-center lg:justify-start">
                  <a
                    class="group inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-neutral-900 rounded-lg hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200 transition-all duration-300 hover:scale-105 cursor-pointer"
                    href={homeContent.buttons.about.href}
                    >{homeContent.buttons.about.text}<svg
                      class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
                    ></a
                  >
                  <a
                    class="group inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-neutral-900 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50 dark:bg-neutral-800 dark:text-neutral-100 dark:border-neutral-600 dark:hover:bg-neutral-700 transition-all duration-300 hover:scale-105 cursor-pointer"
                    href={homeContent.buttons.posts.href}
                    >{homeContent.buttons.posts.text}<svg
                      class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2.5"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
                    ></a
                  >
                </div>
              </div>
              <div
                class="relative w-full lg:w-[45%] flex items-center justify-center bg-transparent overflow-hidden z-20"
              >
                <div
                  class="relative overflow-hidden w-[240px] h-[240px] sm:w-[320px] sm:h-[320px] lg:w-[min(700px,45vw)] lg:h-[min(700px,70vh)] max-w-full"
                >
                  <video
                    src={homeContent.video.src}
                    poster={homeContent.video.poster}
                    autoplay
                    muted
                    loop
                    playsinline
                    aria-label="Raphael Northoff"
                    class="w-full h-full object-cover rounded-2xl shadow-xl hover:scale-105 transition-transform duration-300"
                    style="max-width: 100%; max-height: 100%;"
                  ></video>
                </div>
              </div>
            </div>
          </div>

          <section class="w-full max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 md:pb-24">
            <h2
              class="text-xl font-bold text-neutral-900 dark:text-neutral-100 mb-1"
            >
              Feedback &amp; Comments
            </h2>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-6">
              Leave a comment or some feedback. Name is optional — leave it
              blank and you'll get a random one.
            </p>

            <form id="comment-form" class="flex flex-col gap-3 mb-10">
              <input
                type="text"
                id="comment-name"
                maxlength="40"
                placeholder="Name (optional)"
                class="px-4 py-2 rounded-lg border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-400"
              />
              <textarea
                id="comment-message"
                required
                maxlength="500"
                rows="3"
                placeholder="Your comment..."
                class="px-4 py-2 rounded-lg border border-neutral-300 dark:border-neutral-600 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100 text-sm focus:outline-none focus:ring-2 focus:ring-neutral-400 resize-none"
              ></textarea>
              <input
                type="text"
                id="comment-hp"
                name="website"
                tabindex="-1"
                autocomplete="off"
                class="hidden"
              />
              <div class="flex items-center gap-3">
                <button
                  type="submit"
                  class="self-start inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-neutral-900 rounded-lg hover:bg-neutral-800 dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200 transition-all duration-300 hover:scale-105 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
                >
                  Post Comment
                </button>
                <p
                  id="comment-status"
                  class="text-sm text-red-500 dark:text-red-400 hidden"
                >
                </p>
              </div>
            </form>

            <div id="comments-list" class="flex flex-col gap-4">
              <p
                id="comments-empty"
                class="text-sm text-neutral-500 dark:text-neutral-400 hidden"
              >
                No comments yet — be the first!
              </p>
              <p
                id="comments-unconfigured"
                class="text-sm text-neutral-500 dark:text-neutral-400 hidden"
              >
                Comments aren't set up yet.
              </p>
            </div>
          </section>
        </main>

        <Footer />
      </div>
    </div>
  </body>
</html>
